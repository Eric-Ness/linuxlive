#!/usr/bin/python3
"""linuxlive installer window: asks for a disk, a user and a time zone, makes
the person type "erase" to confirm, then runs install-to-disk (as root, with
the live user's sudo) and shows its progress."""

import os
import re
import subprocess
import tempfile
import threading

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

BACKEND = "/usr/libexec/linuxlive/install-to-disk"


def branding():
    values = {}
    try:
        out = subprocess.run(["bash", "-c", ". /usr/lib/linuxlive/branding.env; printf '%s\\n%s\\n%s\\n%s\\n%s\\n' "
                              "\"$LL_NAME\" \"$LL_ID\" \"$LL_BASE\" \"${LL_HOSTNAME:-$LL_ID}\" \"${LL_AUTOLOGIN_DEFAULT:-0}\""],
                             capture_output=True, text=True, check=True).stdout.split("\n")
        values = {"name": out[0], "id": out[1], "base": out[2], "hostname": out[3], "autologin": out[4]}
    except (OSError, subprocess.CalledProcessError, IndexError):
        pass
    name, id_ = values.get("name") or "linuxlive", values.get("id") or "linuxlive"
    # The spec's settings: the computer name, and whether to log in automatically.
    return {"name": name, "id": id_, "base": values.get("base") or "",
            "hostname": values.get("hostname") or id_, "autologin": values.get("autologin") == "1"}


def disks():
    """The disks install-to-disk sees, and why there are none when it sees none."""
    run = subprocess.run(["sudo", "-n", BACKEND, "--list-disks"], capture_output=True, text=True)
    found = []
    if run.returncode != 0:
        why = (run.stderr.strip().splitlines() or ["no answer"])[-1]
        return found, f"the installer could not look at the disks ({why})"
    for line in run.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            path, size, state = parts[0], int(parts[1] or 0), parts[2]
            model = parts[3] if len(parts) > 3 else ""
            found.append((path, size, state, model))
    return found, None if found else "no disks were found; in a virtual machine, add a disk of 20 GB or more and restart"


def current_timezone():
    try:
        tz = subprocess.run(["timedatectl", "show", "-p", "Timezone", "--value"], capture_output=True, text=True).stdout.strip()
        return tz or "UTC"
    except OSError:
        return "UTC"


def timezones():
    try:
        return subprocess.run(["timedatectl", "list-timezones"], capture_output=True, text=True).stdout.split()
    except OSError:
        return ["UTC"]


class Installer(Gtk.Window):
    def __init__(self):
        spec = branding()
        self.name, self.id, self.base = spec["name"], spec["id"], spec["base"]
        self.default_hostname, self.default_autologin = spec["hostname"], spec["autologin"]
        super().__init__(title=f"Install {self.name}")
        self.set_default_size(560, 0)
        self.set_border_width(18)
        self.connect("destroy", Gtk.main_quit)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.add(self.stack)
        self.stack.add_named(self.form(), "form")
        self.stack.add_named(self.working(), "working")

    def form(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        intro = Gtk.Label(xalign=0, wrap=True)
        intro.set_markup(f"<b>Install {GLib.markup_escape_text(self.name)} on this computer.</b>\n"
                         "The disk you pick is erased completely: every file and system on it is lost."
                         + ("\nThis needs an internet connection: the system (about 3 GB) is downloaded while it installs, "
                            "and afterwards it keeps itself up to date." if self.base == "fedora" else ""))
        box.pack_start(intro, False, False, 0)
        grid = Gtk.Grid(column_spacing=12, row_spacing=10)
        box.pack_start(grid, False, False, 0)

        self.disk = Gtk.ComboBoxText()
        self.disk_paths = []
        found, problem = disks()
        for path, size, state, model in found:
            label = f"{path}  {size / 1e9:.0f} GB  {model}".strip()
            if state != "ok":
                label += f"  (cannot use: {state})"
            self.disk.append_text(label)
            self.disk_paths.append((path, state == "ok"))
        if problem:
            self.disk.append_text(f"No disk to install on: {problem}")
            self.disk_paths.append((None, False))
            self.disk.set_active(0)
        usable = [i for i, (_, ok) in enumerate(self.disk_paths) if ok]
        if usable:
            self.disk.set_active(usable[0])
        self.fullname = Gtk.Entry(placeholder_text="Your name")
        self.user = Gtk.Entry(placeholder_text="lowercase, e.g. alex")
        self.fullname.connect("changed", self.suggest_user)
        self.password = Gtk.Entry(visibility=False)
        self.password2 = Gtk.Entry(visibility=False)
        self.hostname = Gtk.Entry(text=self.default_hostname)
        self.timezone = Gtk.ComboBoxText.new_with_entry()
        for tz in timezones():
            self.timezone.append_text(tz)
        self.timezone.get_child().set_text(current_timezone())
        self.autologin = Gtk.CheckButton(label="Log in automatically", active=self.default_autologin)
        rows = [("Disk to erase", self.disk), ("Your name", self.fullname), ("User name", self.user),
                ("Password", self.password), ("Password again", self.password2),
                ("Computer name", self.hostname), ("Time zone", self.timezone), ("", self.autologin)]
        for i, (label, widget) in enumerate(rows):
            grid.attach(Gtk.Label(label=label, xalign=1), 0, i, 1, 1)
            widget.set_hexpand(True)
            grid.attach(widget, 1, i, 1, 1)

        self.problem = Gtk.Label(xalign=0, wrap=True)
        box.pack_start(self.problem, False, False, 0)
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda _b: self.destroy())
        go = Gtk.Button(label="Erase disk and install")
        go.get_style_context().add_class("destructive-action")
        go.connect("clicked", self.confirm)
        buttons.pack_start(cancel, False, False, 0)
        buttons.pack_start(go, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        if not usable:
            self.say("No disk here can take the install. It needs a disk the live system is not running from, with nothing on it in use.")
            go.set_sensitive(False)
        return box

    def suggest_user(self, entry):
        if not self.user.get_text() or getattr(self, "_auto_user", False):
            first = (entry.get_text().strip().split() or [""])[0].lower()
            self.user.set_text(re.sub(r"[^a-z0-9_-]", "", first)[:32])
            self._auto_user = True

    def say(self, text):
        self.problem.set_markup(f"<span foreground='#b3261e'>{GLib.markup_escape_text(text)}</span>" if text else "")

    def checked(self):
        i = self.disk.get_active()
        if i < 0 or not self.disk_paths[i][1]:
            return "Pick a disk that can be used."
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", self.user.get_text()):
            return "The user name must start with a lowercase letter and use only a-z, 0-9, - and _."
        if not self.password.get_text():
            return "Choose a password."
        if self.password.get_text() != self.password2.get_text():
            return "The two passwords differ."
        if not re.fullmatch(r"[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?", self.hostname.get_text()):
            return "The computer name may use letters, digits and dashes."
        if not os.path.exists(f"/usr/share/zoneinfo/{self.timezone.get_child().get_text()}"):
            return "Pick a time zone from the list."
        return ""

    def confirm(self, _button):
        problem = self.checked()
        self.say(problem)
        if problem:
            return
        disk = self.disk_paths[self.disk.get_active()][0]
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.OK_CANCEL, text=f"Erase {disk}?")
        dialog.format_secondary_text(f"Everything on {disk} will be lost. Type erase to go on.")
        word = Gtk.Entry()
        dialog.get_message_area().pack_start(word, False, False, 0)
        word.show()
        ok = dialog.run() == Gtk.ResponseType.OK and word.get_text().strip().lower() == "erase"
        dialog.destroy()
        if ok:
            self.install(disk)
        else:
            self.say("Nothing was changed.")

    def working(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.status = Gtk.Label(xalign=0, wrap=True, label="Starting…")
        self.bar = Gtk.ProgressBar()
        self.done = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        box.pack_start(self.status, False, False, 0)
        box.pack_start(self.bar, False, False, 0)
        box.pack_start(self.done, False, False, 0)
        return box

    def install(self, disk):
        self.stack.set_visible_child_name("working")
        fd, pwfile = tempfile.mkstemp()
        os.write(fd, (self.password.get_text() + "\n").encode())
        os.close(fd)
        cmd = ["sudo", "-n", BACKEND, "--disk", disk, "--confirm", disk, "--user", self.user.get_text(),
               "--fullname", self.fullname.get_text(), "--password-file", pwfile,
               "--hostname", self.hostname.get_text(), "--timezone", self.timezone.get_child().get_text()]
        cmd.append("--autologin" if self.autologin.get_active() else "--no-autologin")

        def run():
            error = None
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                for line in proc.stdout:
                    if line.startswith("PROGRESS "):
                        _, pct, text = line.rstrip("\n").split(" ", 2)
                        GLib.idle_add(self.progress, int(pct), text)
                    elif line.startswith("ERROR "):
                        error = line[6:].strip()
                if proc.wait() != 0 and not error:
                    error = "The installer stopped with an error."
            finally:
                os.unlink(pwfile)
            GLib.idle_add(self.finished, error)

        threading.Thread(target=run, daemon=True).start()

    def progress(self, pct, text):
        self.bar.set_fraction(pct / 100)
        self.status.set_text(text)

    def finished(self, error):
        if error:
            self.status.set_markup(f"<b>The install did not finish.</b>\n{GLib.markup_escape_text(error)}")
            close = Gtk.Button(label="Close")
            close.connect("clicked", lambda _b: self.destroy())
            self.done.pack_start(close, False, False, 0)
        else:
            self.bar.set_fraction(1)
            self.status.set_markup(f"<b>{GLib.markup_escape_text(self.name)} is installed.</b>\n"
                                   "Restart, remove the USB stick when the screen goes dark, and the computer starts from its disk.")
            later = Gtk.Button(label="Later")
            later.connect("clicked", lambda _b: self.destroy())
            restart = Gtk.Button(label="Restart now")
            restart.get_style_context().add_class("suggested-action")
            restart.connect("clicked", lambda _b: subprocess.run(["systemctl", "reboot"]))
            self.done.pack_start(later, False, False, 0)
            self.done.pack_start(restart, False, False, 0)
        self.done.show_all()


if __name__ == "__main__":
    Installer().show_all()
    Gtk.main()
