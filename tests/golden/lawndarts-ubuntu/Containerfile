# Generated by linuxlive 0.7.0 from spec 'lawn-darts-linux' (Ubuntu 26.04 LTS, Cinnamon).
# Do not edit by hand: change the spec and compile again.

# Stage 1: unpack the signed Secure Boot chain (shim and GRUB) from Ubuntu's
# packages without installing them. The ISO assembler copies these binaries
# into the ISO's EFI partition.
FROM docker.io/library/ubuntu:26.04 AS efi
ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    apt-get update; \
    mkdir -p /tmp/debs /x /out; \
    chown _apt /tmp/debs; \
    cd /tmp/debs; \
    apt-get download shim-signed grub-efi-amd64-signed; \
    for deb in ./*.deb; do dpkg-deb -x "$deb" /x; done; \
    shim=/x/usr/lib/shim/shimx64.efi.dualsigned; \
    if [ ! -f "$shim" ]; then shim=/x/usr/lib/shim/shimx64.efi.signed.latest; fi; \
    cp "$shim" /out/shimx64.efi; \
    cp /x/usr/lib/shim/mmx64.efi /out/mmx64.efi; \
    cp /x/usr/lib/grub/x86_64-efi-signed/gcdx64.efi.signed /out/grubx64.efi

# Stage 2: the distro.
FROM docker.io/library/ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
COPY rootfs/etc/apt/preferences.d/linuxlive /etc/apt/preferences.d/linuxlive

# Base system. The upstream container image is minimized for servers: drop
# its path excludes so new packages keep their docs and translations, and
# remove its default user so casper can create the live user.
RUN set -eux; \
    rm -f /etc/dpkg/dpkg.cfg.d/excludes; \
    if id ubuntu >/dev/null 2>&1; then userdel ubuntu; rm -rf /home/ubuntu; fi; \
    apt-get update; \
    apt-get install -y ubuntu-minimal ubuntu-standard systemd-sysv locales sudo; \
    locale-gen en_US.UTF-8; \
    update-locale LANG=en_US.UTF-8; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Live boot, boot splash, Flatpak, then the kernel.
RUN set -eux; \
    apt-get update; \
    apt-get install -y initramfs-tools casper plymouth plymouth-theme-spinner plymouth-theme-ubuntu-text flatpak network-manager; \
    apt-get install -y --no-install-recommends linux-image-generic; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Desktop: Cinnamon.
RUN set -eux; \
    apt-get update; \
    apt-get install -y cinnamon-core lightdm slick-greeter xserver-xorg gnome-software gnome-software-plugin-flatpak; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# The installer's tools, and the bootloader it installs onto the target disk,
# kept as .debs resolved against this image so the install works offline.
RUN set -eux; \
    apt-get update; \
    apt-get install -y gdisk dosfstools squashfs-tools python3-gi gir1.2-gtk-3.0; \
    mkdir -p /usr/lib/linuxlive/installer/debs/partial; \
    apt-get install -y --download-only -o Dir::Cache::archives=/usr/lib/linuxlive/installer/debs grub-efi-amd64 grub-efi-amd64-signed shim-signed grub-pc-bin efibootmgr mokutil; \
    rm -rf /usr/lib/linuxlive/installer/debs/partial /usr/lib/linuxlive/installer/debs/lock; \
    ls /usr/lib/linuxlive/installer/debs/grub-efi-amd64-signed_*.deb /usr/lib/linuxlive/installer/debs/shim-signed_*.deb; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Branding and linuxlive's boot check.
COPY --from=efi /out/ /usr/lib/linuxlive/efi/
COPY rootfs/ /
# LL_BUILD_ID (optional) names this build in os-release's BUILD_ID.
ARG LL_BUILD_ID=""
RUN /bin/sh /usr/libexec/linuxlive/finalize
