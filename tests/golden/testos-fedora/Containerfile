# Generated by linuxlive 0.3.0 from spec 'testos' (Fedora 44, KDE Plasma).
# Do not edit by hand: change the spec and compile again.

# KDE Plasma on Fedora Atomic. This is a bootc image: installed
# systems take updates by pulling new builds of it.
FROM quay.io/fedora/fedora-kinoite:44

# Live boot (dmsquash-live), live session setup (livesys) and the boot splash.
RUN set -eux; \
    dnf -y install dracut-live livesys-scripts plymouth-theme-spinner plymouth-plugin-two-step; \
    dnf clean all

# Fedora's logos are Fedora's trademarks; a distro that isn't Fedora uses
# Fedora's neutral replacements instead.
RUN set -eux; \
    if rpm -q --quiet fedora-logos; then dnf -y swap fedora-logos generic-logos; fi; \
    if rpm -q --quiet fedora-logos-httpd; then dnf -y swap fedora-logos-httpd generic-logos-httpd; fi; \
    dnf clean all

# The installer's window (usr/libexec/linuxlive/installer); the install
# itself is bootc's, from the published image (install-to-disk).
RUN set -eux; \
    dnf -y install python3-gobject gtk3; \
    dnf clean all

# The distro's own packages (packages in the spec).
RUN set -eux; \
    dnf -y install htop; \
    dnf clean all

COPY rootfs/ /

# Keep a copy of the signed Secure Boot chain where the ISO assembler looks for it.
RUN set -eux; \
    mkdir -p /usr/lib/linuxlive/efi; \
    for name in shimx64.efi grubx64.efi mmx64.efi; do \
        found=$(find /usr/lib/efi /usr/lib/bootupd/updates /boot/efi -type f -name "$name" -path '*fedora*' 2>/dev/null | sort | head -n 1); \
        test -n "$found" || { echo "missing $name in the base image" >&2; exit 1; }; \
        cp "$found" "/usr/lib/linuxlive/efi/$name"; \
    done

# The distro's own build steps (repos, then scripts.build in the spec), as root.
COPY extras/ /tmp/linuxlive-extras/
RUN /bin/sh /usr/libexec/linuxlive/user-build /tmp/linuxlive-extras && rm -rf /tmp/linuxlive-extras

# Branding, linuxlive's boot check and the initramfs.
RUN /bin/sh /usr/libexec/linuxlive/finalize

RUN bootc container lint
