{
  "apps": [
    {
      "flatpak": "org.mozilla.firefox",
      "id": "firefox",
      "name": "Firefox"
    }
  ],
  "base": {
    "id": "fedora",
    "label": "Fedora 44",
    "release": "44"
  },
  "base_image": "quay.io/fedora/fedora-kinoite:44",
  "branding": {
    "accent_color": "#c2185b",
    "gnome_accent": null,
    "logo": "/usr/share/pixmaps/linuxlive-logo.png",
    "wallpaper": "/usr/share/backgrounds/linuxlive/wallpaper.png"
  },
  "desktop": {
    "id": "kde",
    "label": "KDE Plasma",
    "shell_process": "plasmashell"
  },
  "id": "werkbank-linux",
  "iso": {
    "file_name": "werkbank-linux-0.1-fedora-amd64.iso",
    "kernel_args": "root=live:CDLABEL=WERKBANK_LINUX_0_1 rd.live.image rd.live.overlay.overlayfs=1 quiet rhgb",
    "layout": "liveos",
    "volume_id": "WERKBANK_LINUX_0_1"
  },
  "name": "Werkbank Linux",
  "settings": {
    "autologin": true,
    "firefox": {
      "policies": {
        "DontCheckDefaultBrowser": true,
        "Homepage": {
          "Locked": false,
          "StartPage": "homepage",
          "URL": "https://linuxlive.com/learn/"
        },
        "OverrideFirstRunPage": "",
        "OverridePostUpdatePage": ""
      }
    },
    "hidden_apps": [
      "org.kde.konsole",
      "org.kde.kinfocenter"
    ],
    "hostname": "werkbank",
    "keyboard": "de",
    "language": "de_DE",
    "packages": [
      "langpacks-de"
    ],
    "timezone": "Europe/Berlin"
  },
  "version": "0.1"
}
