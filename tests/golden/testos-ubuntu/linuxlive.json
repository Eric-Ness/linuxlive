{
  "apps": [
    {
      "flatpak": "org.mozilla.firefox",
      "id": "firefox",
      "name": "Firefox"
    },
    {
      "flatpak": "org.videolan.VLC",
      "id": "vlc",
      "name": "VLC"
    }
  ],
  "base": {
    "id": "ubuntu",
    "label": "Ubuntu 26.04 LTS",
    "release": "26.04"
  },
  "base_image": "docker.io/library/ubuntu:26.04",
  "branding": {
    "accent_color": "#c2185b",
    "gnome_accent": "pink",
    "logo": "/usr/share/pixmaps/linuxlive-logo.png",
    "wallpaper": "/usr/share/backgrounds/linuxlive/wallpaper.png"
  },
  "desktop": {
    "id": "gnome",
    "label": "GNOME",
    "shell_process": "gnome-shell"
  },
  "extras": {
    "files": [
      {
        "dest": "/etc/motd",
        "mode": "0644",
        "sha256": "ba4985e4af7562852acb57d0d4bdbcc0cfba4f04cd30a5de608d18346130d702"
      }
    ],
    "packages": [
      "htop"
    ],
    "repos": [
      {
        "commit": "7de84ed49850a29bc2fce32d66d0d83509b99daf",
        "url": "https://github.com/Eric-Ness/linuxlive"
      }
    ],
    "scripts": {
      "build": [
        "10-build.sh"
      ],
      "first-boot": [
        "10-first-boot.sh"
      ],
      "first-login": [
        "10-first-login.sh"
      ]
    }
  },
  "id": "testos",
  "iso": {
    "arch": "amd64",
    "file_name": "testos-0.1-ubuntu-amd64.iso",
    "kernel_args": "boot=casper quiet splash ---",
    "layout": "casper",
    "persistence": false,
    "volume_id": "TESTOS_0_1"
  },
  "name": "TestOS",
  "version": "0.1"
}
