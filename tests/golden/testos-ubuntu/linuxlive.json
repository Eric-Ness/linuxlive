{
  "apps": [
    {
      "flatpak": "org.mozilla.firefox",
      "id": "firefox",
      "name": "Firefox"
    },
    {
      "flatpak": "org.videolan.VLC",
      "id": "vlc",
      "name": "VLC"
    }
  ],
  "base": {
    "id": "ubuntu",
    "label": "Ubuntu 26.04 LTS",
    "release": "26.04"
  },
  "base_image": "docker.io/library/ubuntu:26.04",
  "branding": {
    "accent_color": "#c2185b",
    "gnome_accent": "pink",
    "logo": "/usr/share/pixmaps/linuxlive-logo.png",
    "wallpaper": "/usr/share/backgrounds/linuxlive/wallpaper.png"
  },
  "desktop": {
    "id": "gnome",
    "label": "GNOME",
    "shell_process": "gnome-shell"
  },
  "id": "testos",
  "iso": {
    "file_name": "testos-0.1-ubuntu-amd64.iso",
    "kernel_args": "boot=casper quiet splash ---",
    "layout": "casper",
    "volume_id": "TESTOS_0_1"
  },
  "name": "TestOS",
  "version": "0.1"
}
