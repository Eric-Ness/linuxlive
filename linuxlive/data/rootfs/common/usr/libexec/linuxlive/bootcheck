#!/bin/sh
# linuxlive boot check.
#
# Reports how far a boot got by printing LINUXLIVE_* lines to the first serial
# port, where the QEMU test harness (scripts/boottest.py) reads them. It only
# runs when QEMU passes -fw_cfg name=opt/linuxlive/bootcheck, so on real
# hardware, and in VMs started any other way, it exits without doing anything.

# shellcheck disable=SC2154 # os-release variables come from /etc/os-release
flag=/sys/firmware/qemu_fw_cfg/by_name/opt/linuxlive/bootcheck/raw
[ -e "$flag" ] || modprobe qemu_fw_cfg 2>/dev/null
[ -e "$flag" ] || exit 0
exec 3>/dev/ttyS0 || exit 0

say() { printf '%s\n' "$*" >&3; }
fact() { say "LINUXLIVE_FACT $1=$2"; }

say LINUXLIVE_BOOTCHECK_START

# shellcheck source=/dev/null
. /etc/os-release
fact os_name "$NAME"
fact os_pretty_name "$PRETTY_NAME"
fact image_id "${IMAGE_ID:-}"
fact image_version "${IMAGE_VERSION:-}"
fact kernel "$(uname -r)"
fact cmdline "$(cat /proc/cmdline)"
# Live from the ISO, or a system the installer put on a disk.
if grep -qwE 'boot=casper|rd\.live\.image' /proc/cmdline; then fact boot_medium live; else fact boot_medium disk; fi
fact root_fstype "$(findmnt -no FSTYPE / 2>/dev/null)"
if command -v dpkg-query >/dev/null 2>&1; then
	if dpkg-query -W -f='${Status}' casper 2>/dev/null | grep -q 'ok installed'; then fact casper_installed yes; else fact casper_installed no; fi
fi
fact login_users "$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' | sort | tr '\n' ' ' | sed 's/ $//')"

if [ -d /sys/firmware/efi ]; then
	fact firmware uefi
else
	fact firmware bios
fi
secureboot=0
for var in /sys/firmware/efi/efivars/SecureBoot-*; do
	# 4 bytes of attributes, then the value byte.
	[ -e "$var" ] && secureboot=$(od -An -tu1 -j4 -N1 "$var" | tr -d ' \n')
done
fact secureboot "${secureboot:-0}"

theme=""
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
	theme=$(plymouth-set-default-theme 2>/dev/null || true)
fi
if [ -z "$theme" ] && [ -e /usr/share/plymouth/themes/default.plymouth ]; then
	theme=$(basename "$(dirname "$(readlink -f /usr/share/plymouth/themes/default.plymouth)")")
fi
fact plymouth_theme "${theme:-unknown}"
text_theme=none
if [ -e /usr/share/plymouth/themes/text.plymouth ]; then
	text_theme=$(basename "$(dirname "$(readlink -f /usr/share/plymouth/themes/text.plymouth)")")
fi
fact plymouth_text_theme "$text_theme"
# What the boot actually used: the themes packed into this kernel's initramfs.
initrd=""
for candidate in "/boot/initrd.img-$(uname -r)" "/usr/lib/modules/$(uname -r)/initramfs.img"; do
	[ -e "$candidate" ] && initrd=$candidate && break
done
themes=""
if [ -n "$initrd" ]; then
	if command -v lsinitramfs >/dev/null 2>&1; then
		listing=$(lsinitramfs "$initrd" 2>/dev/null)
	else
		listing=$(lsinitrd "$initrd" 2>/dev/null)
	fi
	themes=$(printf '%s\n' "$listing" | sed -n 's|.*usr/share/plymouth/themes/\([^/ ]*\)/.*|\1|p' | sort -u | tr '\n' ' ')
fi
fact initrd_plymouth_themes "${themes:-unknown}"

if command -v getenforce >/dev/null 2>&1; then
	fact selinux "$(getenforce 2>/dev/null)"
else
	fact selinux absent
fi

for app in $(flatpak list --system --app --columns=application 2>/dev/null); do
	fact flatpak "$app"
done

# Upstream branding that a distro which isn't Ubuntu or Fedora must not show.
if command -v rpm >/dev/null 2>&1; then
	logos=$(rpm -qa --qf '%{NAME} ' 'fedora-logos*' 2>/dev/null)
	fact fedora_logo_packages "${logos:-none}"
fi
fact issue "$(head -n 1 /etc/issue 2>/dev/null)"
yaru=/usr/share/icons/Yaru/scalable/actions
if [ -e "$yaru/view-app-grid-ubuntu-symbolic.svg" ]; then
	# Ubuntu's dock draws Show Apps with this icon; Yaru ships it as the Ubuntu logo.
	if cmp -s "$yaru/view-app-grid-ubuntu-symbolic.svg" "$yaru/view-app-grid-symbolic.svg"; then
		fact dock_show_apps_icon generic
	else
		fact dock_show_apps_icon ubuntu
	fi
fi
say LINUXLIVE_BOOTED

# The icons a user's Plasma application launchers show, from Plasma's saved
# layout: a launcher section names the plugin, and its [Configuration][General]
# subsection holds the icon ("default" when the launcher keeps its own).
launcher_icons_in() {
	[ -f "$1" ] || return 0
	awk '
		/^\[/ { section = $0; next }
		/^plugin=org\.kde\.plasma\.(kickoff|kicker|kickerdash)$/ { launcher[section] = 1 }
		/^icon=/ { icon[section] = substr($0, 6) }
		END {
			for (s in launcher) {
				g = s "[Configuration][General]"
				printf "%s ", ((g in icon) ? icon[g] : "default")
			}
		}' "$1" | sed 's/ $//'
}

# Error lines from a user's X session log, their journal, the kernel's (which
# logs segfaults) and systemd-coredump's, for a desktop shell that crashed.
session_errors() {
	home=$(getent passwd "$1" | cut -d: -f6)
	uid=$(id -u "$1")
	{
		if [ -f "$home/.xsession-errors" ]; then tail -n 300 "$home/.xsession-errors"; fi
		journalctl -b --no-pager -o cat "_UID=$uid" 2>/dev/null | tail -n 500
		journalctl -k -b --no-pager -o cat 2>/dev/null | grep -i segfault | tail -n 5
		journalctl -b --no-pager -o cat -t systemd-coredump 2>/dev/null | head -n 20
	} | grep -iE 'error|critical|fatal|segfault|crash|traceback|assert|dumped core|signal|#[0-9]+ ' | tail -n 20 |
		while IFS= read -r line; do fact session_error "$line"; done
}

failed_units() {
	units=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
	units=${units% }
	printf '%s' "${units:-none}"
}

# Update notifiers the user's session starts: autostart entries that exist and
# that the user's own copy does not hide (Fedora's livesys hides Discover's).
update_notifiers() {
	home=$(getent passwd "$1" | cut -d: -f6)
	found=""
	for entry in update-notifier ubuntu-advantage-notification org.kde.discover.notifier; do
		file=/etc/xdg/autostart/$entry.desktop
		[ -e "$home/.config/autostart/$entry.desktop" ] && file=$home/.config/autostart/$entry.desktop
		[ -f "$file" ] || continue
		grep -qx 'Hidden=true' "$file" && continue
		found="$found $entry"
	done
	found=${found# }
	printf '%s' "${found:-none}"
}

# Whether GNOME Software checks for updates, as the session sees it: settings
# can be scoped to a desktop, so read them with the session's XDG_CURRENT_DESKTOP.
gnome_software_updates() {
	home=$(getent passwd "$1" | cut -d: -f6)
	desktop=""
	if [ -n "$2" ]; then
		desktop=$(tr '\0' '\n' <"/proc/$2/environ" 2>/dev/null | sed -n 's/^XDG_CURRENT_DESKTOP=//p')
	fi
	if ! command -v gsettings >/dev/null 2>&1 ||
		! runuser -u "$1" -- env HOME="$home" gsettings list-schemas 2>/dev/null | grep -qx org.gnome.software; then
		printf absent
		return
	fi
	runuser -u "$1" -- env HOME="$home" XDG_CURRENT_DESKTOP="$desktop" \
		gsettings get org.gnome.software allow-updates 2>/dev/null || printf error
}

# The installer Plasma Welcome's live page offers, if any, and whether it exists.
welcome_installer() {
	rc="$(getent passwd "$1" | cut -d: -f6)/.config/plasma-welcomerc"
	installer=$(sed -n 's/^LiveInstaller=//p' "$rc" 2>/dev/null)
	if [ -z "$installer" ]; then
		printf none
	elif [ -e "/usr/share/applications/$installer.desktop" ]; then
		printf '%s' "$installer"
	else
		printf 'missing:%s' "$installer"
	fi
}

# Ubuntu's medium check runs at idle priority and writes its verdict to
# /run/casper-md5check.json. Wait for it until shortly before boottest.py
# stops the VM, then say "running" if it has not finished.
casper_md5check() {
	result=""
	tries=0
	while [ "$tries" -lt 25 ]; do
		result=$(sed -n 's/.*"result": "\([a-z]*\)".*/\1/p' /run/casper-md5check.json 2>/dev/null)
		[ -n "$result" ] && break
		if [ "$(systemctl show -p ActiveState --value casper-md5check.service 2>/dev/null)" = failed ]; then
			result=failed
			break
		fi
		tries=$((tries + 1))
		sleep 2
	done
	printf '%s' "${result:-running}"
}

# Plasma saves the layout a little after the login script changes it, so give
# it up to two minutes to show the distro logo before reporting what is there.
kde_launcher_icons() {
	# shellcheck disable=SC2154 # LL_LOGO_ICON comes from branding.env
	want=$(. /usr/lib/linuxlive/branding.env && printf '%s' "$LL_LOGO_ICON")
	rc="$(getent passwd "$1" | cut -d: -f6)/.config/plasma-org.kde.plasma.desktop-appletsrc"
	found=""
	tries=0
	while [ "$tries" -lt 60 ]; do
		found=$(launcher_icons_in "$rc")
		case " $found " in *" $want "*) break ;; esac
		tries=$((tries + 1))
		sleep 2
	done
	printf '%s' "${found:-none}"
}

# Wait for an active graphical user session with its desktop shell running.
deadline=$(($(date +%s) + 2700))
while [ "$(date +%s)" -lt "$deadline" ]; do
	for session in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
		class=$(loginctl show-session "$session" -p Class --value 2>/dev/null)
		state=$(loginctl show-session "$session" -p State --value 2>/dev/null)
		type=$(loginctl show-session "$session" -p Type --value 2>/dev/null)
		[ "$class" = user ] && [ "$state" = active ] || continue
		[ "$type" = wayland ] || [ "$type" = x11 ] || continue
		user=$(loginctl show-session "$session" -p Name --value 2>/dev/null)
		shell=""
		for proc in gnome-shell plasmashell cinnamon; do
			if pgrep -u "$user" -x "$proc" >/dev/null 2>&1; then
				shell=$proc
			fi
		done
		[ -n "$shell" ] || continue
		fact session_type "$type"
		fact session_desktop "$(loginctl show-session "$session" -p Desktop --value 2>/dev/null)"
		fact session_user "$user"
		fact shell "$shell"
		# The installer's launcher: on the live user's desktop, or missing.
		if [ -f /usr/share/applications/linuxlive-install.desktop ]; then
			if [ -f "$(getent passwd "$user" | cut -d: -f6)/Desktop/linuxlive-install.desktop" ]; then
				fact installer_icon desktop
			else
				fact installer_icon menu-only
			fi
		fi
		if [ "$shell" = plasmashell ]; then
			fact kde_launcher_icon "$(kde_launcher_icons "$user")"
		fi
		fact failed_units "$(failed_units)"
		if [ -d /sys/fs/selinux ]; then
			fact avc_denials "$(journalctl -k -b --no-pager 2>/dev/null | grep -c 'avc:  denied')"
			journalctl -k -b --no-pager -o cat 2>/dev/null | grep 'avc:  denied' | head -n 5 |
				while IFS= read -r line; do fact avc "$line"; done
		fi
		say LINUXLIVE_SESSION_READY
		ready=$(date +%s)
		# A desktop shell can start and then crash (Cinnamon then shows its
		# fallback-mode dialog). Look again once the session has settled, and
		# keep the session's own error lines if the shell is gone.
		sleep 30
		pid=$(pgrep -u "$user" -x "$shell" 2>/dev/null | head -n 1)
		if [ -n "$pid" ]; then
			fact shell_after_settle "$shell"
		else
			fact shell_after_settle none
			session_errors "$user"
		fi
		# Units that failed later, such as ones started after login.
		fact failed_units_after_settle "$(failed_units)"
		fact update_notifiers "$(update_notifiers "$user")"
		fact gnome_software_updates "$(gnome_software_updates "$user" "$pid")"
		if [ "$shell" = plasmashell ]; then
			fact plasma_welcome_installer "$(welcome_installer "$user")"
		fi
		if systemctl cat casper-md5check.service >/dev/null 2>&1; then
			fact casper_md5check "$(casper_md5check)"
		fi
		[ -n "$pid" ] || exit 0
		# Then keep watching until the test harness stops the VM: Cinnamon has
		# crashed a minute after login, after the look above. Its launcher then
		# starts metacity and shows the fallback-mode dialog, with a process
		# still called cinnamon-launch(er), so the shell's own pid is watched.
		fact shell_watch "$shell"
		while [ -d "/proc/$pid" ] && ! pgrep -u "$user" -x metacity >/dev/null 2>&1; do
			sleep 2
		done
		fact shell_crashed "$(($(date +%s) - ready))"
		session_errors "$user"
		exit 0
	done
	sleep 5
done
say LINUXLIVE_SESSION_TIMEOUT
exit 1
